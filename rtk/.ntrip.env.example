# NTRIP credentials for rtk_bridge_node — COPY to `.ntrip.env` and fill in.
# `.ntrip.env` is git-ignored; never commit real credentials.
#
# Place the real file where the bridge can read it (default path used by
# service/start_rtk_bridge.sh):  /tinynav/rtk/.ntrip.env
# On the dog this maps to host  /home/dm/workspace/tinynav/rtk/.ntrip.env
# (bind-mounted, so it survives container restart). Then: chmod 600 .ntrip.env
#
# The node reads these as TINYNAV_NTRIP_* env vars (see rtk_bridge_node.py
# _declare_params defaults). start_rtk_bridge.sh `source`s this file.

export TINYNAV_NTRIP_HOST=120.253.239.161
export TINYNAV_NTRIP_PORT=8002
export TINYNAV_NTRIP_MOUNTPOINT=RTCM33_GRCEJ
export TINYNAV_NTRIP_USER=your-user
export TINYNAV_NTRIP_PASSWORD=your-password
