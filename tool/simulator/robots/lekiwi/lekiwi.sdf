<?xml version="1.0" ?>
<!-- The lekiwi rig: diff-drive cylinder + D435i sensor suite, exactly
     the model that used to be inlined in the world files. Spawn pose is
     the spawner's decision (scripts/run_simulator.sh keeps the per-world
     table): a teleport after VIO init poisons the ISAM graph, so the pose
     must be right at create time. -->
<sdf version="1.9">
<model name='lekiwi' canonical_link='chassis'>
            <plugin
                filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
                <left_joint>left_wheel_joint</left_joint>
                <right_joint>right_wheel_joint</right_joint>
                <wheel_separation>0.19</wheel_separation>
                <wheel_radius>0.033</wheel_radius>
                <odom_publish_frequency>20</odom_publish_frequency>
                <topic>cmd_vel</topic>
            </plugin>

            <pose>0 0 0 0 0 0</pose>
            <link name='chassis'>
                <pose relative_to='__model__'>0 0 0.083 0 0 0</pose>
                <sensor name="imu_sensor" type="imu">
                    <always_on>1</always_on>
                    <update_rate>200</update_rate>
                    <visualize>true</visualize>
                    <topic>/camera/camera/imu</topic>
                    <pose>0.05 0 0.02 1.5708 3.14159 1.5708</pose>
                </sensor>
                <inertial>
                    <mass>1.0</mass>
                    <inertia>
                        <ixx>0.0033</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.0033</iyy>
                        <iyz>0</iyz>
                        <izz>0.005</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.1</radius>
                            <length>0.1</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>0.0 0.0 1.0 1</ambient>
                        <diffuse>0.0 0.0 1.0 1</diffuse>
                        <specular>0.0 0.0 1.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.1</radius>
                            <length>0.1</length>
                        </cylinder>
                    </geometry>
                </collision>
            </link>

            <!-- Infra1 Camera Link (Left), world height ~0.10m -->
            <link name='infra1_link'>
                <pose relative_to="chassis">0.09 0.0255 0.017 0 0 0</pose>
                <inertial>
                    <mass>0.03</mass>
                    <inertia>
                        <ixx>1e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1e-5</iyy>
                        <iyz>0</iyz>
                        <izz>1e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.2 0.2 1</ambient>
                        <diffuse>0.2 0.2 0.2 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                </collision>
                <sensor name="infra1" type="camera">
                    <camera>
                        <horizontal_fov>1.5708</horizontal_fov>
                        <image>
                            <width>544</width>
                            <height>480</height>
                            <format>L8</format>
                        </image>
                        <clip>
                            <near>0.1</near>
                            <far>100</far>
                        </clip>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>15</update_rate>
                    <visualize>true</visualize>
                    <topic>/camera/camera/infra1/image_rect_raw</topic>
                </sensor>
            </link>

            <!-- Infra2 Camera Link (Right) -->
            <link name='infra2_link'>
                <pose relative_to="chassis">0.09 -0.0255 0.017 0 0 0</pose>
                <inertial>
                    <mass>0.03</mass>
                    <inertia>
                        <ixx>1e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1e-5</iyy>
                        <iyz>0</iyz>
                        <izz>1e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.2 0.2 1</ambient>
                        <diffuse>0.2 0.2 0.2 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                </collision>
                <sensor name="infra2" type="camera">
                    <camera>
                        <horizontal_fov>1.5708</horizontal_fov>
                        <image>
                            <width>544</width>
                            <height>480</height>
                            <format>L8</format>
                        </image>
                        <clip>
                            <near>0.1</near>
                            <far>100</far>
                        </clip>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>15</update_rate>
                    <visualize>true</visualize>
                    <topic>/camera/camera/infra2/image_rect_raw</topic>
                </sensor>
            </link>

            <!-- Color Camera Link (RGB), centered between the IR pair.
                 Same intrinsics as the IR cameras so camera_info K applies verbatim. -->
            <link name='color_link'>
                <pose relative_to="chassis">0.09 0 0.017 0 0 0</pose>
                <inertial>
                    <mass>0.03</mass>
                    <inertia>
                        <ixx>1e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1e-5</iyy>
                        <iyz>0</iyz>
                        <izz>1e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.2 0.2 1</ambient>
                        <diffuse>0.2 0.2 0.2 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                </collision>
                <sensor name="color" type="camera">
                    <camera>
                        <horizontal_fov>1.5708</horizontal_fov>
                        <image>
                            <width>544</width>
                            <height>480</height>
                            <format>RGB_INT8</format>
                        </image>
                        <clip>
                            <near>0.1</near>
                            <far>100</far>
                        </clip>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>15</update_rate>
                    <visualize>true</visualize>
                    <topic>/camera/camera/color/image_raw</topic>
                </sensor>
            </link>

            <link name='left_wheel'>
                <pose relative_to="chassis">0 0.095 -0.05 -1.5707 0 0</pose>
                <inertial>
                    <mass>0.05</mass>
                    <inertia>
                        <ixx>1.5e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1.5e-5</iyy>
                        <iyz>0</iyz>
                        <izz>2.7e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.033</radius>
                            <length>0.02</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>1.0 0.0 0.0 1</ambient>
                        <diffuse>1.0 0.0 0.0 1</diffuse>
                        <specular>1.0 0.0 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.033</radius>
                            <length>0.02</length>
                        </cylinder>
                    </geometry>
                </collision>
            </link>

            <link name='right_wheel'>
                <pose relative_to="chassis">0 -0.095 -0.05 -1.5707 0 0</pose>
                <inertial>
                    <mass>0.05</mass>
                    <inertia>
                        <ixx>1.5e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1.5e-5</iyy>
                        <iyz>0</iyz>
                        <izz>2.7e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.033</radius>
                            <length>0.02</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>1.0 0.0 0.0 1</ambient>
                        <diffuse>1.0 0.0 0.0 1</diffuse>
                        <specular>1.0 0.0 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.033</radius>
                            <length>0.02</length>
                        </cylinder>
                    </geometry>
                </collision>
            </link>

            <joint name='left_wheel_joint' type='revolute'>
                <parent>chassis</parent>
                <child>left_wheel</child>
                <axis>
                    <xyz>0 0 1</xyz>
                </axis>
            </joint>

            <joint name='right_wheel_joint' type='revolute'>
                <parent>chassis</parent>
                <child>right_wheel</child>
                <axis>
                    <xyz>0 0 1</xyz>
                </axis>
            </joint>

            <frame name="caster_frame" attached_to='chassis'>
                <pose>-0.07 0 -0.062 0 0 0</pose>
            </frame>
            <link name='caster'>
                <pose relative_to='caster_frame'/>
                <inertial>
                    <mass>0.05</mass>
                    <inertia>
                        <ixx>8e-6</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>8e-6</iyy>
                        <iyz>0</iyz>
                        <izz>8e-6</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <sphere>
                            <radius>0.02</radius>
                        </sphere>
                    </geometry>
                    <material>
                        <ambient>0.0 1 0.0 1</ambient>
                        <diffuse>0.0 1 0.0 1</diffuse>
                        <specular>0.0 1 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <sphere>
                            <radius>0.02</radius>
                        </sphere>
                    </geometry>
                </collision>
            </link>

            <joint name='caster_wheel' type='ball'>
                <parent>chassis</parent>
                <child>caster</child>
            </joint>

            <!-- Front ball caster: balances the forward camera weight so the
                 chassis stays level on the two drive wheels. -->
            <frame name="front_caster_frame" attached_to='chassis'>
                <pose>0.07 0 -0.062 0 0 0</pose>
            </frame>
            <link name='front_caster'>
                <pose relative_to='front_caster_frame'/>
                <inertial>
                    <mass>0.05</mass>
                    <inertia>
                        <ixx>8e-6</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>8e-6</iyy>
                        <iyz>0</iyz>
                        <izz>8e-6</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <sphere>
                            <radius>0.02</radius>
                        </sphere>
                    </geometry>
                    <material>
                        <ambient>0.0 1 0.0 1</ambient>
                        <diffuse>0.0 1 0.0 1</diffuse>
                        <specular>0.0 1 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <sphere>
                            <radius>0.02</radius>
                        </sphere>
                    </geometry>
                </collision>
            </link>

            <joint name='front_caster_wheel' type='ball'>
                <parent>chassis</parent>
                <child>front_caster</child>
            </joint>

            <joint name='infra1_joint' type='fixed'>
                <parent>chassis</parent>
                <child>infra1_link</child>
            </joint>

            <joint name='infra2_joint' type='fixed'>
                <parent>chassis</parent>
                <child>infra2_link</child>
            </joint>

            <joint name='color_joint' type='fixed'>
                <parent>chassis</parent>
                <child>color_link</child>
            </joint>
        </model>
</sdf>
