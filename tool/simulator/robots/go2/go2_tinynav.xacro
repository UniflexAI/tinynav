<?xml version="1.0"?>
<!-- Self-contained Go2 rig: chassis, legs and the D435i sensor head in one
     file. No meshes: every visual is a copy of the collision primitive, so
     the joint origins, limits, inertials and collisions are the single
     source of geometry. The dog renders near-black for visibility.

     Spawn-chain constraints (spawn.sh): robot_state_publisher must precede
     `create` (GazeboSimROS2ControlPlugin reads robot_description from its
     parameter API) and the model must enter gz via `create -file` (the
     -topic path drops every sensor pose). -->
<robot name="go2_tinynav" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="robot_name" default="robot1"/>
  <!-- absolute path of ros_control.yaml, passed by spawn.sh:
       GazeboSimROS2ControlPlugin loads it from inside the gz server -->
  <xacro:arg name="ctl_config" default=""/>
  <!-- ${...} expressions read properties, not args -->
  <xacro:property name="robot_name" value="$(arg robot_name)"/>

  <xacro:property name="PI" value="3.1415926535897931"/>
  <xacro:property name="trunk_width" value="0.187"/>
  <xacro:property name="trunk_length" value="0.3762"/>
  <xacro:property name="trunk_height" value="0.114"/>
  <xacro:property name="hip_radius" value="0.046"/>
  <xacro:property name="hip_length" value="0.04"/>
  <xacro:property name="thigh_width" value="0.0245"/>
  <xacro:property name="thigh_height" value="0.034"/>
  <xacro:property name="calf_width" value="0.016"/>
  <xacro:property name="calf_height" value="0.016"/>
  <xacro:property name="foot_radius" value="0.02"/>
  <xacro:property name="thigh_offset" value="0.0955"/>
  <xacro:property name="thigh_length" value="0.213"/>
  <xacro:property name="calf_length" value="0.213"/>
  <xacro:property name="leg_offset_x" value="0.1934"/>
  <xacro:property name="leg_offset_y" value="0.0465"/>
  <xacro:property name="hip_offset" value="0.0955"/>
  <xacro:property name="damping" value="0.01"/>
  <xacro:property name="friction" value="0.2"/>
  <xacro:property name="hip_position_max" value="1.0472"/>
  <xacro:property name="hip_position_min" value="-1.0472"/>
  <xacro:property name="hip_velocity_max" value="30.1"/>
  <xacro:property name="hip_torque_max" value="23.7"/>
  <xacro:property name="thigh_position_max" value="3.4907"/>
  <xacro:property name="thigh_position_min" value="-1.5708"/>
  <xacro:property name="thigh_velocity_max" value="30.1"/>
  <xacro:property name="thigh_torque_max" value="23.7"/>
  <xacro:property name="calf_position_max" value="-0.83776"/>
  <xacro:property name="calf_position_min" value="-2.7227"/>
  <xacro:property name="calf_velocity_max" value="20.06"/>
  <xacro:property name="calf_torque_max" value="35.55"/>
  <xacro:property name="trunk_mass" value="6.921"/>
  <xacro:property name="trunk_com_x" value="0.021112"/>
  <xacro:property name="trunk_com_y" value="0.00"/>
  <xacro:property name="trunk_com_z" value="-0.005366"/>
  <xacro:property name="trunk_ixx" value="0.02448"/>
  <xacro:property name="trunk_ixy" value="0.00012166"/>
  <xacro:property name="trunk_ixz" value="0.0014849"/>
  <xacro:property name="trunk_iyy" value="0.098077"/>
  <xacro:property name="trunk_iyz" value="-3.12E-05"/>
  <xacro:property name="trunk_izz" value="0.107"/>
  <xacro:property name="hip_mass" value="0.678"/>
  <xacro:property name="hip_com_x" value="-0.0054"/>
  <xacro:property name="hip_com_y" value="0.00194"/>
  <xacro:property name="hip_com_z" value="-0.000105"/>
  <xacro:property name="hip_ixx" value="0.00048"/>
  <xacro:property name="hip_ixy" value="-3.01E-06"/>
  <xacro:property name="hip_ixz" value="1.11E-06"/>
  <xacro:property name="hip_iyy" value="0.000884"/>
  <xacro:property name="hip_iyz" value="-1.42E-06"/>
  <xacro:property name="hip_izz" value="0.000596"/>
  <xacro:property name="thigh_mass" value="1.152"/>
  <xacro:property name="thigh_com_x" value="-0.00374"/>
  <xacro:property name="thigh_com_y" value="-0.0223"/>
  <xacro:property name="thigh_com_z" value="-0.0327"/>
  <xacro:property name="thigh_ixx" value="0.00584"/>
  <xacro:property name="thigh_ixy" value="8.72E-05"/>
  <xacro:property name="thigh_ixz" value="-0.000289"/>
  <xacro:property name="thigh_iyy" value="0.0058"/>
  <xacro:property name="thigh_iyz" value="0.000808"/>
  <xacro:property name="thigh_izz" value="0.00103"/>
  <xacro:property name="calf_mass" value="0.154"/>
  <xacro:property name="calf_com_x" value="0.00548"/>
  <xacro:property name="calf_com_y" value="-0.000975"/>
  <xacro:property name="calf_com_z" value="-0.115"/>
  <xacro:property name="calf_ixx" value="0.00108"/>
  <xacro:property name="calf_ixy" value="3.4E-07"/>
  <xacro:property name="calf_ixz" value="1.72E-05"/>
  <xacro:property name="calf_iyy" value="0.0011"/>
  <xacro:property name="calf_iyz" value="8.28E-06"/>
  <xacro:property name="calf_izz" value="3.29E-05"/>
  <xacro:property name="foot_mass" value="0.06"/>

  <!-- near-black with a trace of diffuse so edges stay readable in gz -->
  <material name="black">
    <color rgba="0.03 0.03 0.03 1"/>
  </material>

  <!-- One leg: hip, upper, lower, foot. mirror = +1 left / -1 right,
       front_hind = +1 front / -1 hind; they scale the joint offsets, the
       hip-axis limit signs and the inertial off-diagonal signs. -->
  <xacro:macro name="leg" params="name mirror front_hind">

    <joint name="${name}_hip_joint" type="revolute">
      <origin rpy="0 0 0" xyz="${front_hind*leg_offset_x} ${mirror*leg_offset_y} 0"/>
      <parent link="trunk"/>
      <child link="${name}_hip_link"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="${damping}" friction="${friction}"/>
      <xacro:if value="${mirror == 1}">
        <limit effort="${hip_torque_max}" velocity="${hip_velocity_max}" lower="${hip_position_min}" upper="${hip_position_max}"/>
      </xacro:if>
      <xacro:if value="${mirror == -1}">
        <limit effort="${hip_torque_max}" velocity="${hip_velocity_max}" lower="${-hip_position_max}" upper="${-hip_position_min}"/>
      </xacro:if>
    </joint>

    <link name="${name}_hip_link">
      <visual>
        <origin rpy="${PI/2.0} 0 0" xyz="0 ${hip_offset*mirror} 0"/>
        <geometry>
          <cylinder length="${hip_length}" radius="${hip_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="${PI/2.0} 0 0" xyz="0 ${hip_offset*mirror} 0"/>
        <geometry>
          <cylinder length="${hip_length}" radius="${hip_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="${hip_com_x*front_hind} ${hip_com_y*mirror} ${hip_com_z}"/>
        <mass value="${hip_mass}"/>
        <inertia
            ixx="${hip_ixx}" ixy="${hip_ixy*mirror*front_hind}" ixz="${hip_ixz*front_hind}"
            iyy="${hip_iyy}" iyz="${hip_iyz*mirror}"
            izz="${hip_izz}"/>
      </inertial>
    </link>

    <joint name="${name}_upper_leg_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0 ${thigh_offset*mirror} 0"/>
      <parent link="${name}_hip_link"/>
      <child link="${name}_upper_leg_link"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${damping}" friction="${friction}"/>
      <limit effort="${thigh_torque_max}" velocity="${thigh_velocity_max}" lower="${thigh_position_min}" upper="${thigh_position_max}"/>
    </joint>

    <link name="${name}_upper_leg_link">
      <visual>
        <origin rpy="0 ${PI/2.0} 0" xyz="0 0 ${-thigh_length/2.0}"/>
        <geometry>
          <box size="${thigh_length} ${thigh_width} ${thigh_height}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="0 ${PI/2.0} 0" xyz="0 0 ${-thigh_length/2.0}"/>
        <geometry>
          <box size="${thigh_length} ${thigh_width} ${thigh_height}"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="${thigh_com_x} ${thigh_com_y*mirror} ${thigh_com_z}"/>
        <mass value="${thigh_mass}"/>
        <inertia
            ixx="${thigh_ixx}" ixy="${thigh_ixy*mirror}" ixz="${thigh_ixz}"
            iyy="${thigh_iyy}" iyz="${thigh_iyz*mirror}"
            izz="${thigh_izz}"/>
      </inertial>
    </link>

    <joint name="${name}_lower_leg_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 ${-thigh_length}"/>
      <parent link="${name}_upper_leg_link"/>
      <child link="${name}_lower_leg_link"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${damping}" friction="${friction}"/>
      <limit effort="${calf_torque_max}" velocity="${calf_velocity_max}" lower="${calf_position_min}" upper="${calf_position_max}"/>
    </joint>

    <link name="${name}_lower_leg_link">
      <visual>
        <origin rpy="0 ${PI/2.0} 0" xyz="0 0 ${-calf_length/2.0}"/>
        <geometry>
          <box size="${calf_length} ${calf_width} ${calf_height}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="0 ${PI/2.0} 0" xyz="0 0 ${-calf_length/2.0}"/>
        <geometry>
          <box size="${calf_length} ${calf_width} ${calf_height}"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="${calf_com_x} ${calf_com_y} ${calf_com_z}"/>
        <mass value="${calf_mass}"/>
        <inertia
            ixx="${calf_ixx}" ixy="${calf_ixy}" ixz="${calf_ixz}"
            iyy="${calf_iyy}" iyz="${calf_iyz}"
            izz="${calf_izz}"/>
      </inertial>
    </link>

    <joint name="${name}_foot_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 ${-(calf_length)}"/>
      <parent link="${name}_lower_leg_link"/>
      <child link="${name}_foot_link"/>
    </joint>

    <link name="${name}_foot_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <sphere radius="${foot_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <sphere radius="${foot_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${foot_mass}"/>
        <inertia
            ixx="${(2*foot_mass)/5.0*(foot_radius*foot_radius)}" ixy="0.0" ixz="0.0"
            iyy="${(2*foot_mass)/5.0*(foot_radius*foot_radius)}" iyz="0.0"
            izz="${(2*foot_mass)/5.0*(foot_radius*foot_radius)}"/>
      </inertial>
    </link>

  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="floating_base" type="fixed">
    <!-- 0.27 = the held-crouch stance height (trunk above ground, measured):
         the model origin sits on the ground under the trunk, lekiwi-style, so
         scene resets and spawns address every robot with z=0 -->
    <origin rpy="0 0 0" xyz="0 0 0.27"/>
    <parent link="base_link"/>
    <child link="trunk"/>
  </joint>

  <link name="trunk">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="${trunk_com_x} ${trunk_com_y} ${trunk_com_z}"/>
      <mass value="${trunk_mass}"/>
      <inertia
          ixx="${trunk_ixx}" ixy="${trunk_ixy}" ixz="${trunk_ixz}"
          iyy="${trunk_iyy}" iyz="${trunk_iyz}"
          izz="${trunk_izz}"/>
    </inertial>
  </link>

  <xacro:leg name="rf" mirror="-1" front_hind="1"/>
  <xacro:leg name="lf" mirror="1"  front_hind="1"/>
  <xacro:leg name="rh" mirror="-1" front_hind="-1"/>
  <xacro:leg name="lh" mirror="1"  front_hind="-1"/>

  <!-- D435i sensor head on the snout. Topics, resolutions, rates and the
       0.051 m stereo baseline match the lekiwi rig verbatim, so
       perception_node and camera_info_publisher cannot tell the robots
       apart. The IMU carries the same camera-convention rotation as
       lekiwi's (body Z = camera forward).

       gz cameras look along the link's +X axis; the links stay unrotated
       (forward = base_link +X). -->
  <xacro:property name="head_x" value="0.19"/>
  <xacro:property name="head_z" value="0.09"/>
  <xacro:property name="cam_y" value="0.0255"/>

  <xacro:macro name="sensor_link" params="name x y z">
    <!-- NO visual: a visual near the camera origin would be rendered by the
         camera itself (inside its own bounding mesh) -->
    <link name="${name}_link">
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <!-- the head rides the trunk: base_link is the ground-level model
           origin and would put the sensors underground -->
      <parent link="trunk"/>
      <child link="${name}_link"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="rc_joint" params="name init:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <!-- held by gz_ros2_control from spawn until the first controller
             activates: the frozen pre-controller pose is this, not the URDF
             zero (straight legs). Values = the trot controller's own steady
             stance commands (read off /robot1/joint_group_controller/commands),
             so spawn -> controller handover is seamless. -->
        <param name="initial_value">${init}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="gz_camera" params="name topic format">
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="camera">
        <!-- identity translation: gz-sim's URDF importer lumps the fixed-joint
             child into base_link but preserves its frame, so the sensor already
             sits at (head_x, +-cam_y, head_z); a nonzero pose here would
             double-apply the offsets (a doubled 0.102 m baseline once halved
             every depth and sank the VIO under motion) -->
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>544</width>
            <height>480</height>
            <format>${format}</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>${topic}</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- stereo pair + RGB, all on the head -->
  <xacro:sensor_link name="camera_infra1" x="${head_x}" y="${cam_y}" z="${head_z}"/>
  <xacro:sensor_link name="camera_infra2" x="${head_x}" y="-${cam_y}" z="${head_z}"/>
  <xacro:sensor_link name="camera_color" x="${head_x}" y="0" z="${head_z}"/>
  <xacro:gz_camera name="camera_infra1"
                   topic="/camera/camera/infra1/image_rect_raw" format="L8"/>
  <xacro:gz_camera name="camera_infra2"
                   topic="/camera/camera/infra2/image_rect_raw" format="L8"/>
  <xacro:gz_camera name="camera_color"
                   topic="/camera/camera/color/image_raw" format="RGB_INT8"/>

  <xacro:sensor_link name="camera_imu" x="0.15" y="0" z="${head_z}"/>
  <gazebo reference="camera_imu_link">
    <sensor name="camera_imu" type="imu">
      <always_on>1</always_on>
      <update_rate>200</update_rate>
      <visualize>true</visualize>
      <topic>/camera/camera/imu</topic>
      <!-- identity translation, same lumping reason as the cameras; the RPY
           stays: it is the camera-convention rotation (body Z = forward) -->
      <pose>0 0 0 1.5708 3.14159 1.5708</pose>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libign_ros2_control-system.so">
      <ros>
        <namespace>/${robot_name}</namespace>
      </ros>
      <parameters>$(arg ctl_config)</parameters>
    </plugin>
  </gazebo>

  <ros2_control name="${robot_name}_GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:rc_joint name="lf_hip_joint"/>
    <xacro:rc_joint name="lf_upper_leg_joint" init="0.861"/>
    <xacro:rc_joint name="lf_lower_leg_joint" init="-1.883"/>
    <xacro:rc_joint name="rf_hip_joint"/>
    <xacro:rc_joint name="rf_upper_leg_joint" init="0.861"/>
    <xacro:rc_joint name="rf_lower_leg_joint" init="-1.883"/>
    <xacro:rc_joint name="lh_hip_joint"/>
    <xacro:rc_joint name="lh_upper_leg_joint" init="0.944"/>
    <xacro:rc_joint name="lh_lower_leg_joint" init="-1.887"/>
    <xacro:rc_joint name="rh_hip_joint"/>
    <xacro:rc_joint name="rh_upper_leg_joint" init="0.944"/>
    <xacro:rc_joint name="rh_lower_leg_joint" init="-1.887"/>
  </ros2_control>

  <!-- contact surfaces -->
  <gazebo reference="trunk">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="lf_hip_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="lf_upper_leg_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="lf_lower_leg_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
  </gazebo>
  <gazebo reference="lf_foot_link">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <self_collide>1</self_collide>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="rf_upper_leg_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="rf_lower_leg_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
  </gazebo>
  <gazebo reference="rf_foot_link">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <self_collide>1</self_collide>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="lh_upper_leg_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="lh_lower_leg_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
  </gazebo>
  <gazebo reference="lh_foot_link">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <self_collide>1</self_collide>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="rh_upper_leg_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>
  <gazebo reference="rh_lower_leg_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>1</self_collide>
  </gazebo>
  <gazebo reference="rh_foot_link">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <self_collide>1</self_collide>
    <kp>10000.0</kp>
    <kd>1.0</kd>
  </gazebo>

</robot>
