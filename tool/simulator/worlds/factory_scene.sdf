<?xml version="1.0" ?>
<sdf version="1.9">
    <world name="factory_01_world">
        <!-- Keyboard teleop lives in tinynav/platforms/keyboard_teleop.py (global
             X listener). The old gz-side TriggeredPublisher arrow plugins were
             removed: they published /cmd_vel on keypress with no zero-on-release
             counterpart, so a stale auto-repeat event after keyup kept the gz
             diff-drive (which holds its last twist) rolling. -->
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1</real_time_factor>
        </physics>
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>
        <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
        </plugin>

        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <scene>
            <ambient>1 1 1 1</ambient>
            <background>0.3 0.7 0.9 1</background>
            <shadows>0</shadows>
            <grid>1</grid>
        </scene>

        <!-- OBJ/MTL materials render near-black under scene ambient alone;
             a strong directional light makes the plant textures readable. -->
        <light name="sun" type="directional">
            <pose>0 0 10 0 0 0</pose>
            <direction>-0.3 0.3 -1</direction>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <attenuation>
                <range>1000</range>
            </attenuation>
            <intensity>3</intensity>
        </light>

        <!-- Indoor-sky shell: the plant is open-top, so cameras see raw sky
             whose invalid stereo disparity (NaN) slips past the `< 0.1` gate
             in perception and kills the VIO optimizer. A visual-only ceiling
             mirrors the depot's ROOF_visual; no collision on purpose. -->
        <model name='sky_shell'>
            <static>1</static>
            <link name='link'>
                <visual name='ceiling'>
                    <pose>35 0 12 0 0 0</pose>
                    <geometry>
                        <plane>
                            <normal>0 0 -1</normal>
                            <size>220 160</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.6 0.6 0.6 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name='ground_plane'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>1 1</size>
                        </plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode/>
                        </friction>
                        <bounce/>
                        <contact/>
                    </surface>
                </collision>
            </link>
            <pose>0 0 0.002 0 0 0</pose>
        </model>
        <!-- Plant digital-twin (metaverse SCENE glb): textured visual mesh +
             simplified collision mesh. The model package lives OUTSIDE the
             repo; run_simulator.sh puts its parent dir on
             IGN_GAZEBO_RESOURCE_PATH. Plant deck around the origin sits at
             z~0.28, hence the raised spawn pose of the robot. -->
        <include>
            <uri>model://factory_01</uri>
            <name>factory</name>
            <pose>0 0 0 0 0 0</pose>
            <static>true</static>
        </include>

        <!-- Robot Model: LeKiwi-like cylindrical base.
             Dims from SIGRobotics-UIUC/LeKiwi URDF: wheel r=0.033, track 0.19,
             base ~0.2m. Stereo baseline stays 0.051 (matches camera_info). -->
        <model name='lekiwi' canonical_link='chassis'>
            <plugin
                filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
                <left_joint>left_wheel_joint</left_joint>
                <right_joint>right_wheel_joint</right_joint>
                <wheel_separation>0.19</wheel_separation>
                <wheel_radius>0.033</wheel_radius>
                <odom_publish_frequency>20</odom_publish_frequency>
                <topic>cmd_vel</topic>
            </plugin>

            <!-- Spawn at the factory_01 scene start so VIO initializes there:
                 a teleport right after init poisons the ISAM pose graph (the
                 graph keeps re-solving for minutes and can hang). scene_runner
                 set_pose's the same pose at reset, a no-op. -->
            <pose relative_to='world'>-5.71 2.68 0.28 0 0 -1.57</pose>
            <link name='chassis'>
                <pose relative_to='__model__'>0 0 0.083 0 0 0</pose>
                <sensor name="imu_sensor" type="imu">
                    <always_on>1</always_on>
                    <update_rate>200</update_rate>
                    <visualize>true</visualize>
                    <topic>/camera/camera/imu</topic>
                    <pose>0.05 0 0.02 1.5708 3.14159 1.5708</pose>
                </sensor>
                <inertial>
                    <mass>1.0</mass>
                    <inertia>
                        <ixx>0.0033</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.0033</iyy>
                        <iyz>0</iyz>
                        <izz>0.005</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.1</radius>
                            <length>0.1</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>0.0 0.0 1.0 1</ambient>
                        <diffuse>0.0 0.0 1.0 1</diffuse>
                        <specular>0.0 0.0 1.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.1</radius>
                            <length>0.1</length>
                        </cylinder>
                    </geometry>
                </collision>
            </link>

            <!-- Infra1 Camera Link (Left), world height ~0.10m -->
            <link name='infra1_link'>
                <pose relative_to="chassis">0.09 0.0255 0.017 0 0 0</pose>
                <inertial>
                    <mass>0.03</mass>
                    <inertia>
                        <ixx>1e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1e-5</iyy>
                        <iyz>0</iyz>
                        <izz>1e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.2 0.2 1</ambient>
                        <diffuse>0.2 0.2 0.2 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                </collision>
                <sensor name="infra1" type="camera">
                    <camera>
                        <horizontal_fov>1.5708</horizontal_fov>
                        <image>
                            <width>544</width>
                            <height>480</height>
                            <format>L8</format>
                        </image>
                        <clip>
                            <near>0.1</near>
                            <far>100</far>
                        </clip>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>15</update_rate>
                    <visualize>true</visualize>
                    <topic>/camera/camera/infra1/image_rect_raw</topic>
                </sensor>
            </link>

            <!-- Infra2 Camera Link (Right) -->
            <link name='infra2_link'>
                <pose relative_to="chassis">0.09 -0.0255 0.017 0 0 0</pose>
                <inertial>
                    <mass>0.03</mass>
                    <inertia>
                        <ixx>1e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1e-5</iyy>
                        <iyz>0</iyz>
                        <izz>1e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.2 0.2 1</ambient>
                        <diffuse>0.2 0.2 0.2 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                </collision>
                <sensor name="infra2" type="camera">
                    <camera>
                        <horizontal_fov>1.5708</horizontal_fov>
                        <image>
                            <width>544</width>
                            <height>480</height>
                            <format>L8</format>
                        </image>
                        <clip>
                            <near>0.1</near>
                            <far>100</far>
                        </clip>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>15</update_rate>
                    <visualize>true</visualize>
                    <topic>/camera/camera/infra2/image_rect_raw</topic>
                </sensor>
            </link>

            <!-- Color Camera Link (RGB), centered between the IR pair.
                 Same intrinsics as the IR cameras so camera_info K applies verbatim. -->
            <link name='color_link'>
                <pose relative_to="chassis">0.09 0 0.017 0 0 0</pose>
                <inertial>
                    <mass>0.03</mass>
                    <inertia>
                        <ixx>1e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1e-5</iyy>
                        <iyz>0</iyz>
                        <izz>1e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.2 0.2 1</ambient>
                        <diffuse>0.2 0.2 0.2 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <box>
                            <size>0.025 0.025 0.025</size>
                        </box>
                    </geometry>
                </collision>
                <sensor name="color" type="camera">
                    <camera>
                        <horizontal_fov>1.5708</horizontal_fov>
                        <image>
                            <width>544</width>
                            <height>480</height>
                            <format>RGB_INT8</format>
                        </image>
                        <clip>
                            <near>0.1</near>
                            <far>100</far>
                        </clip>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>15</update_rate>
                    <visualize>true</visualize>
                    <topic>/camera/camera/color/image_raw</topic>
                </sensor>
            </link>

            <link name='left_wheel'>
                <pose relative_to="chassis">0 0.095 -0.05 -1.5707 0 0</pose>
                <inertial>
                    <mass>0.05</mass>
                    <inertia>
                        <ixx>1.5e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1.5e-5</iyy>
                        <iyz>0</iyz>
                        <izz>2.7e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.033</radius>
                            <length>0.02</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>1.0 0.0 0.0 1</ambient>
                        <diffuse>1.0 0.0 0.0 1</diffuse>
                        <specular>1.0 0.0 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.033</radius>
                            <length>0.02</length>
                        </cylinder>
                    </geometry>
                </collision>
            </link>

            <link name='right_wheel'>
                <pose relative_to="chassis">0 -0.095 -0.05 -1.5707 0 0</pose>
                <inertial>
                    <mass>0.05</mass>
                    <inertia>
                        <ixx>1.5e-5</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>1.5e-5</iyy>
                        <iyz>0</iyz>
                        <izz>2.7e-5</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.033</radius>
                            <length>0.02</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>1.0 0.0 0.0 1</ambient>
                        <diffuse>1.0 0.0 0.0 1</diffuse>
                        <specular>1.0 0.0 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.033</radius>
                            <length>0.02</length>
                        </cylinder>
                    </geometry>
                </collision>
            </link>

            <joint name='left_wheel_joint' type='revolute'>
                <parent>chassis</parent>
                <child>left_wheel</child>
                <axis>
                    <xyz>0 0 1</xyz>
                </axis>
            </joint>

            <joint name='right_wheel_joint' type='revolute'>
                <parent>chassis</parent>
                <child>right_wheel</child>
                <axis>
                    <xyz>0 0 1</xyz>
                </axis>
            </joint>

            <frame name="caster_frame" attached_to='chassis'>
                <pose>-0.07 0 -0.062 0 0 0</pose>
            </frame>
            <link name='caster'>
                <pose relative_to='caster_frame'/>
                <inertial>
                    <mass>0.05</mass>
                    <inertia>
                        <ixx>8e-6</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>8e-6</iyy>
                        <iyz>0</iyz>
                        <izz>8e-6</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <sphere>
                            <radius>0.02</radius>
                        </sphere>
                    </geometry>
                    <material>
                        <ambient>0.0 1 0.0 1</ambient>
                        <diffuse>0.0 1 0.0 1</diffuse>
                        <specular>0.0 1 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <sphere>
                            <radius>0.02</radius>
                        </sphere>
                    </geometry>
                </collision>
            </link>

            <joint name='caster_wheel' type='ball'>
                <parent>chassis</parent>
                <child>caster</child>
            </joint>

            <!-- Front ball caster: balances the forward camera weight so the
                 chassis stays level on the two drive wheels. -->
            <frame name="front_caster_frame" attached_to='chassis'>
                <pose>0.07 0 -0.062 0 0 0</pose>
            </frame>
            <link name='front_caster'>
                <pose relative_to='front_caster_frame'/>
                <inertial>
                    <mass>0.05</mass>
                    <inertia>
                        <ixx>8e-6</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>8e-6</iyy>
                        <iyz>0</iyz>
                        <izz>8e-6</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <sphere>
                            <radius>0.02</radius>
                        </sphere>
                    </geometry>
                    <material>
                        <ambient>0.0 1 0.0 1</ambient>
                        <diffuse>0.0 1 0.0 1</diffuse>
                        <specular>0.0 1 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <sphere>
                            <radius>0.02</radius>
                        </sphere>
                    </geometry>
                </collision>
            </link>

            <joint name='front_caster_wheel' type='ball'>
                <parent>chassis</parent>
                <child>front_caster</child>
            </joint>

            <joint name='infra1_joint' type='fixed'>
                <parent>chassis</parent>
                <child>infra1_link</child>
            </joint>

            <joint name='infra2_joint' type='fixed'>
                <parent>chassis</parent>
                <child>infra2_link</child>
            </joint>

            <joint name='color_joint' type='fixed'>
                <parent>chassis</parent>
                <child>color_link</child>
            </joint>
        </model>

    </world>
</sdf>
