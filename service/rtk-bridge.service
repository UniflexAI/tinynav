# systemd unit to autostart the RTK bridge (NTRIP + /fix,/rtk/odom,/rtk/status)
# on the robot HOST, mirroring how the web app is brought up (a launcher script
# run inside the tinynav container).
#
# Install on the dog host:
#   sudo cp /path/to/tinynav/service/rtk-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rtk-bridge
#   journalctl -u rtk-bridge -f          # logs
#
# It waits for the tinynav container, then runs the self-heal launcher inside it
# in the foreground (systemd supervises it; the launcher also self-heals the node
# on receiver hiccups). Change tinynav-dev if your container name differs.
[Unit]
Description=TinyNav RTK bridge (NTRIP autostart)
After=docker.service
Requires=docker.service

[Service]
ExecStartPre=/bin/bash -c 'until docker exec tinynav-dev true 2>/dev/null; do sleep 2; done'
ExecStart=/usr/bin/docker exec tinynav-dev /tinynav/service/start_rtk_bridge.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
